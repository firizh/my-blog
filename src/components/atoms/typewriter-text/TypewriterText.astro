---
export interface Props {
	text: string | string[];
	speed?: number;
	deleteSpeed?: number;
	pauseTime?: number;
	class?: string;
	hitokoto?: boolean;
	hitokotoCategories?: string[];
}

const {
	text,
	speed = 100,
	deleteSpeed = 50,
	pauseTime = 2000,
	class: className = "",
	hitokoto = false,
	hitokotoCategories = [],
} = Astro.props;
const textData = Array.isArray(text) ? JSON.stringify(text) : text;
---

<span
	class={`typewriter ${className}`}
	data-text={textData}
	data-speed={speed}
	data-delete-speed={deleteSpeed}
	data-pause-time={pauseTime}
	data-hitokoto={hitokoto ? "true" : undefined}
	data-hitokoto-categories={hitokotoCategories.join(",")}></span>

<script>
	class TypewriterEffect {
		private element: HTMLElement;
		private texts: string[];
		private currentTextIndex = 0;
		private speed: number;
		private deleteSpeed: number;
		private pauseTime: number;
		private currentIndex = 0;
		private isDeleting = false;
		private timeoutId: number | null = null;
		private hitokoto = false;
		private hitokotoCategories: string[] = [];

		constructor(element: HTMLElement) {
			this.element = element;
			const textData = element.dataset.text || "";

			// 尝试解析为 JSON 数组，如果失败则作为单个字符串处理
			try {
				const parsed = JSON.parse(textData);
				this.texts = Array.isArray(parsed) ? parsed : [textData];
			} catch {
				this.texts = [textData];
			}

			this.speed = parseInt(element.dataset.speed || "100");
			this.deleteSpeed = parseInt(element.dataset.deleteSpeed || "50");
			this.pauseTime = parseInt(element.dataset.pauseTime || "2000");
			this.hitokoto = element.dataset.hitokoto === "true";
			this.hitokotoCategories = (element.dataset.hitokotoCategories || "")
				.split(",")
				.map((c) => c.trim())
				.filter(Boolean);

			if (this.hitokoto) {
				this.startHitokoto();
			} else if (this.texts.length > 1 && !this.isTypewriterEnabled()) {
				// 如果有多条文本且未启用打字机效果，随机显示一条
				this.showRandomText();
			} else {
				this.start();
			}
		}

		// 从一言API获取随机句子，失败时返回 null
		private async fetchHitokoto(): Promise<string | null> {
			const params = new URLSearchParams();
			for (const c of this.hitokotoCategories) {
				params.append("c", c);
			}
			const query = params.toString();
			const apiUrl = `https://v1.hitokoto.cn/${query ? `?${query}` : ""}`;
			try {
				const res = await fetch(apiUrl);
				if (!res.ok) {
					return null;
				}
				const data = await res.json();
				return typeof data?.hitokoto === "string" && data.hitokoto.trim()
					? data.hitokoto.trim()
					: null;
			} catch {
				return null;
			}
		}

		// 一言模式：先获取句子（失败时回退到静态文本），然后开始打字
		private async startHitokoto() {
			const sentence = await this.fetchHitokoto();
			if (sentence) {
				this.texts = [sentence];
			}
			this.currentTextIndex = 0;
			this.currentIndex = 0;
			this.isDeleting = false;
			this.start();
		}

		// 一言模式：获取下一句后继续打字循环，失败时保留当前句子
		private async fetchNextAndType() {
			const sentence = await this.fetchHitokoto();
			if (sentence) {
				this.texts = [sentence];
				this.currentTextIndex = 0;
			}
			this.type();
		}

		private isTypewriterEnabled(): boolean {
			// 检查是否有打字机相关的数据属性
			return (
				this.element.dataset.speed !== undefined ||
				this.element.dataset.deleteSpeed !== undefined ||
				this.element.dataset.pauseTime !== undefined
			);
		}

		private showRandomText() {
			const randomIndex = Math.floor(Math.random() * this.texts.length);
			this.element.textContent = this.texts[randomIndex];
		}

		private start() {
			if (this.texts.length === 0) {
				return;
			}
			this.type();
		}

		private getCurrentText(): string {
			return this.texts[this.currentTextIndex] || "";
		}

		private type() {
			const currentText = this.getCurrentText();

			if (this.isDeleting) {
				// 删除字符
				if (this.currentIndex > 0) {
					this.currentIndex--;
					this.element.textContent = currentText.substring(
						0,
						this.currentIndex,
					);
					this.timeoutId = window.setTimeout(
						() => this.type(),
						this.deleteSpeed,
					);
				} else {
					// 删除完成，切换到下一条文本
					this.isDeleting = false;
					if (this.hitokoto) {
						// 一言模式：获取下一句后继续
						this.timeoutId = window.setTimeout(
							() => void this.fetchNextAndType(),
							this.speed,
						);
					} else {
						this.currentTextIndex =
							(this.currentTextIndex + 1) % this.texts.length;
						this.timeoutId = window.setTimeout(
							() => this.type(),
							this.speed,
						);
					}
				}
			} else {
				// 添加字符
				if (this.currentIndex < currentText.length) {
					this.currentIndex++;
					this.element.textContent = currentText.substring(
						0,
						this.currentIndex,
					);
					this.timeoutId = window.setTimeout(
						() => this.type(),
						this.speed,
					);
				} else {
					// 打字完成，暂停后开始删除（如果有多条文本或一言模式需要轮播）
					if (this.texts.length > 1 || this.hitokoto) {
						this.isDeleting = true;
						this.timeoutId = window.setTimeout(
							() => this.type(),
							this.pauseTime,
						);
					} else {
						// 如果只有一条文本，保持显示不删除，但确保元素有内容
						if (this.texts.length === 1 && this.texts[0] === "") {
							this.element.innerHTML = "&nbsp;"; // 使用不间断空格保持布局
						}
					}
				}
			}
		}

		public destroy() {
			if (this.timeoutId) {
				clearTimeout(this.timeoutId);
			}
		}
	}

	// 初始化所有打字机效果
	document.addEventListener("DOMContentLoaded", () => {
		const typewriterElements = document.querySelectorAll(".typewriter");
		typewriterElements.forEach((element) => {
			new TypewriterEffect(element as HTMLElement);
		});
	});

	// 支持页面切换时重新初始化
	document.addEventListener("swup:contentReplaced", () => {
		const typewriterElements = document.querySelectorAll(".typewriter");
		typewriterElements.forEach((element) => {
			new TypewriterEffect(element as HTMLElement);
		});
	});
</script>

<style>
	.typewriter {
		position: relative;
		min-height: 1.5em; /* 确保即使没有文字也保持最小高度 */
		display: inline-block;
		vertical-align: baseline;
	}

	/* 确保打字机效果不会导致布局抖动 */
	.typewriter:empty::before {
		content: "\00A0"; /* 使用不间断空格保持高度 */
		visibility: hidden;
	}
</style>
